@@ -0,0 +1,132 @@
+import { createClient } from "@/lib/supabase/server";
+
+/**
+ * Chiffres des tableaux de bord.
+ *
+ * Les agrégats sont calculés par des fonctions SQL `security invoker` : la RLS
+ * s'applique, un appelant ne peut donc additionner que ses propres lignes, et
+ * aucun identifiant n'est passé en entrée (les fonctions travaillent sur
+ * `auth.uid()`). Les montants sont renvoyés en texte pour être convertis en
+ * `bigint` sans perte de précision au passage en JSON.
+ *
+ * Voir supabase/migrations/0020_dashboard_stats_and_storage_hardening.sql.
+ */
+
+export type ProviderStats = {
+  earnedNetMinor: bigint;
+  inEscrowMinor: bigint;
+  disputedMinor: bigint;
+  ordersTotal: number;
+  ordersCompleted: number;
+  ordersActive: number;
+  ordersToDeliver: number;
+  servicesTotal: number;
+  servicesActive: number;
+  servicesDraft: number;
+  servicesPaused: number;
+  unreadMessages: number;
+  pendingInquiries: number;
+  currency: string;
+};
+
+export type ClientStats = {
+  spentMinor: bigint;
+  inEscrowMinor: bigint;
+  ordersTotal: number;
+  ordersActive: number;
+  ordersCompleted: number;
+  ordersToPay: number;
+  ordersToReview: number;
+  unreadMessages: number;
+  currency: string;
+};
+
+type RawStats = Record<string, string | number | null>;
+
+function toBigInt(value: string | number | null | undefined): bigint {
+  if (value === null || value === undefined) return 0n;
+  try {
+    return BigInt(value);
+  } catch {
+    return 0n;
+  }
+}
+
+function toNumber(value: string | number | null | undefined): number {
+  const n = Number(value ?? 0);
+  return Number.isFinite(n) ? n : 0;
+}
+
+async function callStats(rpc: "provider_dashboard_stats" | "client_dashboard_stats"): Promise<RawStats | null> {
+  const supabase = await createClient();
+  const { data, error } = await supabase.rpc(rpc);
+
+  if (error) {
+    // Le tableau de bord ne doit pas casser si la migration 0020 n'est pas
+    // encore appliquée : on journalise et l'écran affiche des zéros.
+    console.error(`[dashboard-stats] ${rpc}:`, error.message);
+    return null;
+  }
+
+  return (data ?? {}) as RawStats;
+}
+
+export async function getProviderStats(): Promise<ProviderStats> {
+  const raw = (await callStats("provider_dashboard_stats")) ?? {};
+  return {
+    earnedNetMinor: toBigInt(raw.earned_net_minor),
+    inEscrowMinor: toBigInt(raw.in_escrow_minor),
+    disputedMinor: toBigInt(raw.disputed_minor),
+    ordersTotal: toNumber(raw.orders_total),
+    ordersCompleted: toNumber(raw.orders_completed),
+    ordersActive: toNumber(raw.orders_active),
+    ordersToDeliver: toNumber(raw.orders_to_deliver),
+    servicesTotal: toNumber(raw.services_total),
+    servicesActive: toNumber(raw.services_active),
+    servicesDraft: toNumber(raw.services_draft),
+    servicesPaused: toNumber(raw.services_paused),
+    unreadMessages: toNumber(raw.unread_messages),
+    pendingInquiries: toNumber(raw.pending_inquiries),
+    currency: typeof raw.currency === "string" ? raw.currency : "XOF",
+  };
+}
+
+export async function getClientStats(): Promise<ClientStats> {
+  const raw = (await callStats("client_dashboard_stats")) ?? {};
+  return {
+    spentMinor: toBigInt(raw.spent_minor),
+    inEscrowMinor: toBigInt(raw.in_escrow_minor),
+    ordersTotal: toNumber(raw.orders_total),
+    ordersActive: toNumber(raw.orders_active),
+    ordersCompleted: toNumber(raw.orders_completed),
+    ordersToPay: toNumber(raw.orders_to_pay),
+    ordersToReview: toNumber(raw.orders_to_review),
+    unreadMessages: toNumber(raw.unread_messages),
+    currency: typeof raw.currency === "string" ? raw.currency : "XOF",
+  };
+}
+
+/** File d'attente d'administration (clé de service, après `requireAdmin()`). */
+export type AttentionQueue = {
+  pendingVerifications: number;
+  manualReview: number;
+  openDisputes: number;
+  draftServices: number;
+  stalledOrders: number;
+  awaitingRelease: number;
+  oldestPendingVerification: string | null;
+};
+
+export function parseAttentionQueue(raw: RawStats | null): AttentionQueue {
+  const r = raw ?? {};
+  return {
+    pendingVerifications: toNumber(r.pending_verifications),
+    manualReview: toNumber(r.manual_review),
+    openDisputes: toNumber(r.open_disputes),
+    draftServices: toNumber(r.draft_services),
+    stalledOrders: toNumber(r.stalled_orders),
+    awaitingRelease: toNumber(r.awaiting_release),
+    oldestPendingVerification:
+      typeof r.oldest_pending_verification === "string" ? r.oldest_pending_verification : null,
+  };
+}
