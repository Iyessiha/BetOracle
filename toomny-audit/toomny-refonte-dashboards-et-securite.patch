diff --git a/supabase/migrations/0020_dashboard_stats_and_storage_hardening.sql b/supabase/migrations/0020_dashboard_stats_and_storage_hardening.sql
new file mode 100644
index 0000000..868d1bc
--- /dev/null
+++ b/supabase/migrations/0020_dashboard_stats_and_storage_hardening.sql
@@ -0,0 +1,183 @@
+-- ---------------------------------------------------------------------------
+-- 0020 — Chiffres exacts des tableaux de bord, et durcissement du stockage.
+--
+-- Deux problèmes distincts, corrigés ici :
+--
+-- 1. Les tableaux de bord calculaient leurs totaux en JavaScript sur les 50
+--    dernières commandes (`limit(50)`). Un prestataire ayant dépassé 50
+--    commandes voyait donc des montants faux, sans aucun signe d'erreur. Les
+--    agrégats sont désormais faits en base, sur l'ensemble des lignes, et
+--    filtrés par la RLS puisque les fonctions sont `security invoker`.
+--
+-- 2. Les buckets publics (`avatars`, `service-covers`) n'acceptaient que
+--    l'extension par préfixe de dossier. Une personne authentifiée pouvait y
+--    déposer n'importe quel fichier directement depuis le navigateur, en
+--    contournant les contrôles des routes d'API. Les types et la taille sont
+--    maintenant imposés par le bucket lui-même.
+-- ---------------------------------------------------------------------------
+
+-- 1. Buckets : types MIME et taille maximale imposés côté stockage -----------
+
+update storage.buckets
+set file_size_limit = 3145728, -- 3 Mo
+    allowed_mime_types = array['image/jpeg', 'image/png', 'image/webp']
+where id = 'service-covers';
+
+update storage.buckets
+set file_size_limit = 2097152, -- 2 Mo
+    allowed_mime_types = array['image/jpeg', 'image/png', 'image/webp']
+where id = 'avatars';
+
+-- Les politiques d'écriture vérifient en plus les métadonnées annoncées, pour
+-- que le refus soit explicite même si le réglage du bucket venait à sauter.
+drop policy if exists service_covers_insert on storage.objects;
+create policy service_covers_insert on storage.objects
+  for insert to authenticated with check (
+    bucket_id = 'service-covers'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and coalesce(metadata->>'mimetype', '') in ('image/jpeg', 'image/png', 'image/webp')
+    and coalesce((metadata->>'size')::bigint, 0) between 1 and 3145728
+  );
+
+drop policy if exists avatars_insert on storage.objects;
+create policy avatars_insert on storage.objects
+  for insert to authenticated with check (
+    bucket_id = 'avatars'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and coalesce(metadata->>'mimetype', '') in ('image/jpeg', 'image/png', 'image/webp')
+    and coalesce((metadata->>'size')::bigint, 0) between 1 and 2097152
+  );
+
+-- 2. Annuaire des prestataires ----------------------------------------------
+--
+-- La vue reste volontairement en SECURITY DEFINER (comportement par défaut) :
+-- c'est la projection publique contrôlée de `profiles`, limitée à quatre
+-- colonnes non sensibles. En `security invoker`, elle deviendrait vide pour un
+-- visiteur anonyme, faute de politique de lecture publique sur `profiles` — et
+-- l'ouvrir obligerait à exposer téléphone et e-mail. Le verrou est donc le
+-- choix des colonnes, pas la RLS. `security_barrier` empêche en plus qu'un
+-- opérateur « leakproof » fasse fuiter des lignes non retenues par le filtre.
+alter view public.provider_directory set (security_barrier = on);
+
+-- 3. Chiffres du tableau de bord prestataire ---------------------------------
+--
+-- `security invoker` : la RLS s'applique, un appelant ne peut donc agréger que
+-- ses propres lignes. Aucun paramètre n'est accepté — les statistiques portent
+-- toujours sur l'utilisateur de la session, ce qui supprime toute question
+-- d'identifiant passé en entrée.
+
+create or replace function public.provider_dashboard_stats()
+returns jsonb
+language sql
+stable
+security invoker
+set search_path = public
+as $$
+  with me as (select auth.uid() as id),
+  o as (
+    select status, provider_net_minor
+    from public.orders, me
+    where orders.provider_id = me.id
+  )
+  select jsonb_build_object(
+    'earned_net_minor',   coalesce((select sum(provider_net_minor) from o where status = 'completed'), 0)::text,
+    'in_escrow_minor',    coalesce((select sum(provider_net_minor) from o where status in ('funded', 'in_progress', 'delivered')), 0)::text,
+    'disputed_minor',     coalesce((select sum(provider_net_minor) from o where status = 'disputed'), 0)::text,
+    'orders_total',       (select count(*) from o),
+    'orders_completed',   (select count(*) from o where status = 'completed'),
+    'orders_active',      (select count(*) from o where status in ('funded', 'in_progress', 'delivered')),
+    'orders_to_deliver',  (select count(*) from o where status in ('funded', 'in_progress')),
+    'services_total',     (select count(*) from public.services, me where services.provider_id = me.id),
+    'services_active',    (select count(*) from public.services, me where services.provider_id = me.id and services.status = 'active'),
+    'services_draft',     (select count(*) from public.services, me where services.provider_id = me.id and services.status = 'draft'),
+    'services_paused',    (select count(*) from public.services, me where services.provider_id = me.id and services.status = 'paused'),
+    'unread_messages',    (select count(*) from public.messages m
+                            where m.read_at is null
+                              and m.sender_id <> me.id
+                              and exists (select 1 from public.orders ord
+                                          where ord.id = m.order_id and ord.provider_id = me.id)),
+    'pending_inquiries',  (select count(*) from public.inquiries i, me
+                            where i.to_id = me.id and i.read_at is null),
+    'currency',           coalesce((select currency from o limit 1), 'XOF')
+  );
+$$;
+
+-- 4. Chiffres du tableau de bord client --------------------------------------
+
+create or replace function public.client_dashboard_stats()
+returns jsonb
+language sql
+stable
+security invoker
+set search_path = public
+as $$
+  with me as (select auth.uid() as id),
+  o as (
+    select status, amount_minor, currency
+    from public.orders, me
+    where orders.client_id = me.id
+  )
+  select jsonb_build_object(
+    'spent_minor',       coalesce((select sum(amount_minor) from o
+                                   where status not in ('pending_payment', 'cancelled', 'refunded')), 0)::text,
+    'in_escrow_minor',   coalesce((select sum(amount_minor) from o
+                                   where status in ('funded', 'in_progress', 'delivered')), 0)::text,
+    'orders_total',      (select count(*) from o),
+    'orders_active',     (select count(*) from o where status in ('funded', 'in_progress', 'delivered', 'disputed')),
+    'orders_completed',  (select count(*) from o where status = 'completed'),
+    'orders_to_pay',     (select count(*) from o where status = 'pending_payment'),
+    'orders_to_review',  (select count(*) from o
+                           where status = 'delivered'
+                             and not exists (select 1 from public.reviews r
+                                             where r.order_id = orders.id)),
+    'unread_messages',   (select count(*) from public.messages m
+                            where m.read_at is null
+                              and m.sender_id <> me.id
+                              and exists (select 1 from public.orders ord
+                                          where ord.id = m.order_id and ord.client_id = me.id)),
+    'currency',          coalesce((select currency from o limit 1), 'XOF')
+  );
+$$;
+
+grant execute on function public.provider_dashboard_stats() to authenticated;
+grant execute on function public.client_dashboard_stats() to authenticated;
+
+-- 5. File d'attente de l'administration --------------------------------------
+--
+-- Compteurs d'action immédiate, en une requête, pour la clé de service.
+revoke execute on function public.admin_attention_queue() from public, anon, authenticated;
+
+create or replace function public.admin_attention_queue()
+returns jsonb
+language sql
+stable
+set search_path = public
+as $$
+  select jsonb_build_object(
+    'pending_verifications', (select count(*) from public.verifications where status = 'pending'),
+    'manual_review',         (select count(*) from public.verifications where status = 'manual_review'),
+    'open_disputes',         (select count(*) from public.disputes where status = 'open'),
+    'draft_services',        (select count(*) from public.services where status = 'draft'),
+    'stalled_orders',        (select count(*) from public.orders
+                               where status = 'funded' and created_at < now() - interval '72 hours'),
+    'awaiting_release',      (select count(*) from public.orders
+                               where status = 'delivered' and delivered_at < now() - interval '72 hours'),
+    'oldest_pending_verification', (select min(created_at) from public.verifications where status = 'pending')
+  );
+$$;
+
+grant execute on function public.admin_attention_queue() to service_role;
+
+-- 6. Demandes de contact : droits explicites ---------------------------------
+-- La table a été créée après la révocation globale de 0003 : on fixe ici des
+-- droits lisibles, plutôt que de dépendre des privilèges par défaut du projet.
+grant select, insert on public.inquiries to authenticated;
+grant update (read_at) on public.inquiries to authenticated;
+
+-- 7. Index manquants pour les agrégats ci-dessus ------------------------------
+create index if not exists messages_unread_idx
+  on public.messages (order_id) where read_at is null;
+create index if not exists inquiries_unread_idx
+  on public.inquiries (to_id) where read_at is null;
+create index if not exists orders_delivered_idx
+  on public.orders (delivered_at) where status = 'delivered';
