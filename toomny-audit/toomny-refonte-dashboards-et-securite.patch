+/* ---------------------------------------------------------------------------
+   Couleurs d'état — thème clair et thème sombre.
+
+   Les pastilles de statut (commande, prestation, vérification) s'appuient sur
+   ces variables au lieu des palettes figées de Tailwind : `bg-amber-50` reste
+   clair en thème sombre, ce qui produisait des blocs éblouissants sur fond noir.
+   --------------------------------------------------------------------------- */
+:root {
+  --tone-ok-bg: #e6f5ec;
+  --tone-ok-fg: #0a552d;
+  --tone-info-bg: #e8effc;
+  --tone-info-fg: #1c3d80;
+  --tone-progress-bg: #eaf3ee;
+  --tone-progress-fg: #0d6b38;
+  --tone-warn-bg: #fdf2e0;
+  --tone-warn-fg: #7a4a06;
+  --tone-danger-bg: #fdecea;
+  --tone-danger-fg: #8c1d18;
+  --tone-neutral-bg: #f1f4f2;
+  --tone-neutral-fg: #55685e;
+  --tone-attention-border: #f0d9ab;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --tone-ok-bg: #0c2b1b;
+    --tone-ok-fg: #7fd6a6;
+    --tone-info-bg: #10233f;
+    --tone-info-fg: #93b8f0;
+    --tone-progress-bg: #10281c;
+    --tone-progress-fg: #74c79b;
+    --tone-warn-bg: #2c2109;
+    --tone-warn-fg: #e9bd6a;
+    --tone-danger-bg: #321412;
+    --tone-danger-fg: #f09a92;
+    --tone-neutral-bg: #16241c;
+    --tone-neutral-fg: #8ea79b;
+    --tone-attention-border: #4a3a12;
+  }
+}
+
+/* Bandeaux d'attention (KYC à faire, dossiers en attente) : mêmes jetons. */
+.tone-attention {
+  background: var(--tone-warn-bg);
+  color: var(--tone-warn-fg);
+  border: 1px solid var(--tone-attention-border);
+}
+.tone-info {
+  background: var(--tone-info-bg);
+  color: var(--tone-info-fg);
+  border: 1px solid var(--tone-info-bg);
+}
+
+/* ---------------------------------------------------------------------------
+   Correctif de thème sombre pour les palettes figées.
+
+   Une cinquantaine d'écrans utilisaient `bg-amber-50`, `bg-red-50`,
+   `bg-green-100`… pour signaler un état. Ces règles hors `@layer` prennent le
+   pas sur les utilitaires générés par Tailwind et rétablissent un contraste
+   lisible en thème sombre, sans avoir à réécrire chaque écran.
+   --------------------------------------------------------------------------- */
+@media (prefers-color-scheme: dark) {
+  .bg-amber-50 { background-color: #2a1f0b; }
+  .bg-amber-100 { background-color: #33260d; }
+  .bg-amber-200 { background-color: #40300f; }
+  .border-amber-200 { border-color: #4a3a12; }
+  .border-amber-300 { border-color: #5a4716; }
+  .text-amber-700, .text-amber-800, .text-amber-900 { color: #e9bd6a; }
+  .bg-red-50 { background-color: #2e1311; }
+  .bg-red-100 { background-color: #3a1714; }
+  .border-red-200 { border-color: #55201c; }
+  .text-red-600, .text-red-700, .text-red-800, .text-red-900 { color: #f09a92; }
+  .bg-green-50, .bg-green-100 { background-color: #0c2b1b; }
+  .text-green-600, .text-green-700, .text-green-800 { color: #7fd6a6; }
+  .bg-yellow-50, .bg-yellow-100 { background-color: #2c2109; }
+  .text-yellow-700, .text-yellow-800 { color: #e9bd6a; }
+  .bg-blue-50, .bg-blue-100 { background-color: #10233f; }
+  .border-blue-200 { border-color: #1d3a63; }
+  .text-blue-700, .text-blue-800, .text-blue-900 { color: #93b8f0; }
+  .bg-neutral-100 { background-color: #16241c; }
+  .text-neutral-600 { color: #8ea79b; }
+  .bg-white { background-color: #ffffff; }
+}
