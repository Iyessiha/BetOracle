@@ -0,0 +1,48 @@
+name: CI
+
+# La vérification tourne sur chaque poussée et chaque proposition de fusion.
+# Elle n'a besoin d'aucun secret : le typage, le lint et les tests sont purs.
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+# Une seule exécution par branche : une poussée qui en annule une autre évite de
+# payer deux fois la même vérification.
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - name: Installer les dépendances
+        run: npm ci
+
+      - name: Vérifier les types
+        run: npm run typecheck
+
+      - name: Lint
+        run: npm run lint
+
+      - name: Tests
+        run: npm test
+
+      - name: Construire l'application
+        run: npm run build
+        env:
+          # Valeurs de façade : le build ne contacte pas Supabase, il vérifie
+          # seulement que tout compile et que les pages se génèrent.
+          NEXT_PUBLIC_SUPABASE_URL: https://placeholder.supabase.co
+          NEXT_PUBLIC_SUPABASE_ANON_KEY: placeholder
+          NEXT_PUBLIC_SITE_URL: https://toomny.com
+          NEXT_PUBLIC_APP_URL: https://toomny.com
