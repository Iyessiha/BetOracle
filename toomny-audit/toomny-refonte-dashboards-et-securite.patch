index 0000000..294d0d0
--- /dev/null
+++ b/src/lib/order-status.ts
@@ -0,0 +1,113 @@
+/**
+ * Machine à états des commandes, côté affichage.
+ *
+ * Une seule définition des regroupements de statuts pour toute l'application :
+ * les tableaux de bord, les listes de commandes et la messagerie doivent
+ * compter la même chose. Deux listes divergentes, et le total affiché au
+ * prestataire cesse de correspondre à ses commandes.
+ */
+
+export const ORDER_STATUSES = [
+  "pending_payment",
+  "funded",
+  "in_progress",
+  "delivered",
+  "completed",
+  "disputed",
+  "cancelled",
+  "refunded",
+] as const;
+
+export type OrderStatus = (typeof ORDER_STATUSES)[number];
+
+/** Paiement encaissé, argent retenu chez le partenaire, pas encore versé. */
+export const IN_ESCROW: readonly OrderStatus[] = ["funded", "in_progress", "delivered"];
+
+/** La commande attend une action du prestataire : livrer, ou démarrer. */
+export const PROVIDER_TODO: readonly OrderStatus[] = ["funded", "in_progress"];
+
+/** La commande attend une action du client : payer, ou valider la livraison. */
+export const CLIENT_TODO: readonly OrderStatus[] = ["pending_payment", "delivered"];
+
+/**
+ * Litige ouvert. Les fonds sont toujours chez le partenaire, mais gelés :
+ * on ne les compte ni comme séquestre libérable, ni comme revenu du
+ * prestataire. Le tableau de bord les isole pour cette raison.
+ */
+export const DISPUTED: readonly OrderStatus[] = ["disputed"];
+
+/** États terminaux : plus rien n'en sort. */
+export const CLOSED: readonly OrderStatus[] = ["completed", "cancelled", "refunded"];
+
+export function isOrderStatus(value: string): value is OrderStatus {
+  return (ORDER_STATUSES as readonly string[]).includes(value);
+}
+
+export function isInEscrow(status: string): boolean {
+  return IN_ESCROW.includes(status as OrderStatus);
+}
+
+export function isClosed(status: string): boolean {
+  return CLOSED.includes(status as OrderStatus);
+}
+
+/**
+ * Classes de couleur d'un statut.
+ *
+ * Elles passent par les variables sémantiques de `globals.css`, qui basculent
+ * en thème sombre. Les couleurs figées de la palette Tailwind (`bg-amber-50`,
+ * `text-amber-700`) ne s'inversent pas : sur un écran sombre, elles produisaient
+ * des pavés clairs illisibles.
+ */
+export function statusTone(status: string): string {
+  switch (status) {
+    case "completed":
+      return "bg-[var(--tone-ok-bg)] text-[var(--tone-ok-fg)]";
+    case "funded":
+      return "bg-[var(--tone-info-bg)] text-[var(--tone-info-fg)]";
+    case "in_progress":
+      return "bg-[var(--tone-progress-bg)] text-[var(--tone-progress-fg)]";
+    case "delivered":
+      return "bg-[var(--tone-info-bg)] text-[var(--tone-info-fg)]";
+    case "pending_payment":
+      return "bg-[var(--tone-warn-bg)] text-[var(--tone-warn-fg)]";
+    case "disputed":
+      return "bg-[var(--tone-danger-bg)] text-[var(--tone-danger-fg)]";
+    case "cancelled":
+    case "refunded":
+      return "bg-[var(--tone-neutral-bg)] text-[var(--tone-neutral-fg)]";
+    default:
+      return "bg-[var(--tone-neutral-bg)] text-[var(--tone-neutral-fg)]";
+  }
+}
+
+/** Classes de couleur d'une prestation selon son statut de publication. */
+export function serviceTone(status: string): string {
+  switch (status) {
+    case "active":
+      return "bg-[var(--tone-ok-bg)] text-[var(--tone-ok-fg)]";
+    case "draft":
+      return "bg-[var(--tone-warn-bg)] text-[var(--tone-warn-fg)]";
+    case "paused":
+      return "bg-[var(--tone-progress-bg)] text-[var(--tone-progress-fg)]";
+    case "removed":
+      return "bg-[var(--tone-danger-bg)] text-[var(--tone-danger-fg)]";
+    default:
+      return "bg-[var(--tone-neutral-bg)] text-[var(--tone-neutral-fg)]";
+  }
+}
+
+/** Classes de la pastille d'identité vérifiée. */
+export function verificationTone(status: string): string {
+  switch (status) {
+    case "verified":
+      return "bg-[var(--tone-ok-bg)] text-[var(--tone-ok-fg)]";
+    case "pending":
+    case "manual_review":
+      return "bg-[var(--tone-progress-bg)] text-[var(--tone-progress-fg)]";
+    case "rejected":
+      return "bg-[var(--tone-danger-bg)] text-[var(--tone-danger-fg)]";
+    default:
+      return "bg-[var(--tone-warn-bg)] text-[var(--tone-warn-fg)]";
+  }
+}
