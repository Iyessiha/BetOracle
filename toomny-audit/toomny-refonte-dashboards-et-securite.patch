+export function TableWrap({ children, minWidth = "36rem" }: { children: React.ReactNode; minWidth?: string }) {
+  return (
+    <div className="w-full overflow-x-auto rounded-2xl border border-[var(--border)] bg-[var(--background)]">
+      <table className="w-full text-left text-sm" style={{ minWidth }}>
