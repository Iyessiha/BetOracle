+ * File d'attente d'action immédiate.
+ *
+ * Séparée des chiffres d'ensemble : ce sont ces compteurs qui disent à
+ * l'équipe ce qu'il faut faire maintenant. Agrégés en base par
+ * `admin_attention_queue()` (clé de service, après `requireAdmin()`).
+ */
+export async function getAttentionQueue(): Promise<AttentionQueue> {
+  const db = createAdminClient();
+  const { data, error } = await db.rpc("admin_attention_queue");
+
+  if (error) {
+    console.error("[admin-stats] admin_attention_queue:", error.message);
+    return parseAttentionQueue(null);
+  }
+
+  return parseAttentionQueue(data as Record<string, string | number | null>);
+}
