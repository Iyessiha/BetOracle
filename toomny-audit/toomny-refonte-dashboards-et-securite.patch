@@ -0,0 +1,76 @@
+import { describe, expect, it } from "vitest";
+import { checkImageUpload, sniffImage, MAX_AVATAR_BYTES } from "./image-upload";
+
+/**
+ * Tableau d'octets adossé à un `ArrayBuffer` explicite : `File` refuse un
+ * `Uint8Array<ArrayBufferLike>` (un tampon partagé ne peut pas être un BlobPart).
+ */
+function bytes(...values: number[]): Uint8Array<ArrayBuffer> {
+  const buffer = new Uint8Array(new ArrayBuffer(values.length));
+  buffer.set(values);
+  return buffer;
+}
+
+const JPEG = bytes(0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0x00, 0x01);
+const PNG = bytes(0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d);
+const WEBP = bytes(0x52, 0x49, 0x46, 0x46, 0x24, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50);
+
+describe("sniffImage", () => {
+  it("reconnaît les trois formats acceptés", () => {
+    expect(sniffImage(JPEG)).toEqual({ mime: "image/jpeg", ext: "jpg" });
+    expect(sniffImage(PNG)).toEqual({ mime: "image/png", ext: "png" });
+    expect(sniffImage(WEBP)).toEqual({ mime: "image/webp", ext: "webp" });
+  });
+
+  it("refuse un fichier qui n'est pas une image", () => {
+    // « <!DOCTYPE html> » : un fichier HTML annoncé comme image.
+    const html = new TextEncoder().encode("<!DOCTYPE html><script>alert(1)</script>");
+    expect(sniffImage(html)).toBeNull();
+  });
+
+  it("refuse un fichier trop court pour conclure", () => {
+    expect(sniffImage(bytes(0xff, 0xd8))).toBeNull();
+  });
+
+  it("ne confond pas un RIFF non-WebP avec une image", () => {
+    const riffWav = bytes(0x52, 0x49, 0x46, 0x46, 0x24, 0x00, 0x00, 0x00, 0x57, 0x41, 0x56, 0x45);
+    expect(sniffImage(riffWav)).toBeNull();
+  });
+});
+
+describe("checkImageUpload", () => {
+  it("accepte une image dont le type annoncé correspond au contenu", async () => {
+    const file = new File([PNG], "photo.png", { type: "image/png" });
+    const result = await checkImageUpload(file, MAX_AVATAR_BYTES);
+    expect(result.ok).toBe(true);
+    if (result.ok) expect(result.ext).toBe("png");
+  });
+
+  it("refuse un fichier dont le contenu ne correspond pas au type annoncé", async () => {
+    const file = new File([JPEG], "trompeur.png", { type: "image/png" });
+    const result = await checkImageUpload(file, MAX_AVATAR_BYTES);
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.status).toBe(400);
+  });
+
+  it("refuse du HTML déguisé en JPEG", async () => {
+    const html = new TextEncoder().encode("<html><body>bonjour</body></html>");
+    const file = new File([html], "avatar.jpg", { type: "image/jpeg" });
+    const result = await checkImageUpload(file, MAX_AVATAR_BYTES);
+    expect(result.ok).toBe(false);
+  });
+
+  it("refuse un fichier au-delà de la limite, avec un 413", async () => {
+    const file = new File([PNG], "grand.png", { type: "image/png" });
+    Object.defineProperty(file, "size", { value: MAX_AVATAR_BYTES + 1 });
+    const result = await checkImageUpload(file, MAX_AVATAR_BYTES);
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.status).toBe(413);
+  });
+
+  it("refuse un fichier vide", async () => {
+    const file = new File([], "vide.png", { type: "image/png" });
+    const result = await checkImageUpload(file, MAX_AVATAR_BYTES);
+    expect(result.ok).toBe(false);
+  });
+});
diff --git a/src/lib/image-upload.ts b/src/lib/image-upload.ts
new file mode 100644
index 0000000..b4c73e4
--- /dev/null
+++ b/src/lib/image-upload.ts
@@ -0,0 +1,79 @@
+/**
+ * Contrôle des images envoyées.
+ *
+ * Le type MIME annoncé par le navigateur (`file.type`) est une donnée du client :
+ * il se falsifie en une ligne. On lit donc les octets d'en-tête du fichier pour
+ * établir son type réel, et on refuse tout ce qui ne correspond pas à l'un des
+ * trois formats acceptés. Sans ce contrôle, n'importe quel contenu — page HTML,
+ * script, archive — se dépose dans un bucket public sous un type image.
+ */
+
+export const MAX_AVATAR_BYTES = 2 * 1024 * 1024;
+export const MAX_COVER_BYTES = 3 * 1024 * 1024;
+
+export type ImageMime = "image/jpeg" | "image/png" | "image/webp";
+
+export type ImageExtension = "jpg" | "png" | "webp";
+
+export type SniffedImage = { mime: ImageMime; ext: ImageExtension };
+
+const SIGNATURES: { mime: ImageMime; ext: ImageExtension; matches: (b: Uint8Array) => boolean }[] = [
+  {
+    mime: "image/jpeg",
+    ext: "jpg",
+    matches: (b) => b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff,
+  },
+  {
+    mime: "image/png",
+    ext: "png",
+    matches: (b) =>
+      b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47 &&
+      b[4] === 0x0d && b[5] === 0x0a && b[6] === 0x1a && b[7] === 0x0a,
+  },
+  {
+    mime: "image/webp",
+    ext: "webp",
+    // RIFF....WEBP
+    matches: (b) =>
+      b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46 &&
+      b[8] === 0x57 && b[9] === 0x45 && b[10] === 0x42 && b[11] === 0x50,
+  },
+];
+
+/** Type réel déduit des octets d'en-tête, ou null si le format n'est pas accepté. */
+export function sniffImage(bytes: Uint8Array): SniffedImage | null {
+  if (bytes.length < 12) return null;
+  for (const signature of SIGNATURES) {
+    if (signature.matches(bytes)) return { mime: signature.mime, ext: signature.ext };
+  }
+  return null;
+}
+
+export type ImageCheck =
+  | { ok: true; buffer: ArrayBuffer; mime: ImageMime; ext: ImageExtension }
+  | { ok: false; status: 400 | 413; message: string };
+
+/**
+ * Valide un fichier reçu : taille, type réel, cohérence avec le type annoncé.
+ * Le message d'erreur reste volontairement générique côté client.
+ */
+export async function checkImageUpload(file: File, maxBytes: number): Promise<ImageCheck> {
+  if (file.size > maxBytes) {
+    return { ok: false, status: 413, message: `Fichier trop volumineux (${Math.round(maxBytes / 1024 / 1024)} Mo max)` };
+  }
+  if (file.size === 0) {
+    return { ok: false, status: 400, message: "Fichier vide" };
+  }
+
+  const buffer = await file.arrayBuffer();
+  const sniffed = sniffImage(new Uint8Array(buffer.slice(0, 16)));
+
+  if (!sniffed) {
+    return { ok: false, status: 400, message: "Format non reconnu (JPEG, PNG ou WebP attendu)" };
+  }
+  if (file.type && file.type !== sniffed.mime) {
+    return { ok: false, status: 400, message: "Le contenu du fichier ne correspond pas à son type annoncé" };
+  }
+
+  return { ok: true, buffer, mime: sniffed.mime, ext: sniffed.ext };
+}
diff --git a/src/lib/order-status.test.ts b/src/lib/order-status.test.ts
new file mode 100644
index 0000000..b846408
--- /dev/null
+++ b/src/lib/order-status.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, it } from "vitest";
+import {
+  CLOSED,
+  CLIENT_TODO,
+  DISPUTED,
+  IN_ESCROW,
+  ORDER_STATUSES,
+  PROVIDER_TODO,
+  isClosed,
+  isInEscrow,
+  isOrderStatus,
+  serviceTone,
+  statusTone,
+  verificationTone,
+} from "./order-status";
+
+describe("regroupements de statuts", () => {
+  it("aucun statut terminé n'apparaît dans une liste d'action", () => {
+    // Un statut fermé ne peut être ni en séquestre, ni à livrer, ni à payer.
+    for (const status of CLOSED) {
+      expect(IN_ESCROW.includes(status)).toBe(false);
+      expect(PROVIDER_TODO.includes(status)).toBe(false);
+      expect(CLIENT_TODO.includes(status)).toBe(false);
+      expect(DISPUTED.includes(status)).toBe(false);
+    }
+  });
+
+  it("un litige n'est ni un séquestre libérable ni une action ordinaire", () => {
+    for (const status of DISPUTED) {
+      expect(IN_ESCROW.includes(status)).toBe(false);
+      expect(PROVIDER_TODO.includes(status)).toBe(false);
+      expect(CLIENT_TODO.includes(status)).toBe(false);
+    }
+  });
+
+  it("les commandes financées attendent bien une action du prestataire", () => {
+    // Ce recouvrement est voulu : l'argent est retenu ET le prestataire doit agir.
+    expect(PROVIDER_TODO).toContain("funded");
+    expect(IN_ESCROW).toContain("funded");
+  });
+
+  it("tout statut de l'énumération est classé explicitement", () => {
+    // Filet de sécurité : ajouter un statut à l'enum sans le classer ici fait
+    // échouer ce test, plutôt que de produire un tableau de bord silencieusement faux.
+    const classes = new Set<string>([
+      ...IN_ESCROW,
+      ...DISPUTED,
+      ...CLOSED,
+      ...PROVIDER_TODO,
+      ...CLIENT_TODO,
+      "pending_payment",
+    ]);
+    for (const status of ORDER_STATUSES) {
+      expect(classes.has(status), `${status} non classé`).toBe(true);
+    }
+  });
+
+  it("tout statut des listes est un statut connu", () => {
+    for (const status of [...IN_ESCROW, ...PROVIDER_TODO, ...CLIENT_TODO, ...CLOSED]) {
+      expect(isOrderStatus(status)).toBe(true);
+    }
+  });
+
+  it("reconnaît les états terminaux et le séquestre", () => {
+    expect(isInEscrow("delivered")).toBe(true);
+    expect(isInEscrow("completed")).toBe(false);
+    expect(isClosed("refunded")).toBe(true);
+    expect(isClosed("disputed")).toBe(false);
+  });
+});
+
+describe("couleurs d'état", () => {
+  it("donne des classes distinctes à des états de nature différente", () => {
+    const done = statusTone("completed");
+    const blocked = statusTone("disputed");
+    const waiting = statusTone("pending_payment");
+    expect(new Set([done, blocked, waiting]).size).toBe(3);
+  });
+
+  it("s'appuie sur les jetons de thème, jamais sur une couleur figée", () => {
+    for (const status of ORDER_STATUSES) {
+      expect(statusTone(status)).toContain("var(--tone-");
+    }
+    for (const status of ["active", "draft", "paused", "removed", "inconnu"]) {
+      expect(serviceTone(status)).toContain("var(--tone-");
+    }
+    for (const status of ["verified", "pending", "manual_review", "rejected", "none"]) {
+      expect(verificationTone(status)).toContain("var(--tone-");
+    }
+  });
+
+  it("ne laisse pas une couleur claire figée qui casserait le thème sombre", () => {
+    expect(statusTone("completed")).not.toMatch(/bg-(amber|red|green|blue|neutral)-\d/);
+    expect(statusTone("disputed")).not.toMatch(/bg-(amber|red|green|blue|neutral)-\d/);
+  });
+});
diff --git a/src/lib/order-status.ts b/src/lib/order-status.ts
